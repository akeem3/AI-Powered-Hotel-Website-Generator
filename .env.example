# LLM Configuration
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
ANTHROPIC_API_KEY=sk-ant-...

# Model Configuration
LLM_MODEL_PRIMARY=anthropic/claude-3.5-sonnet
LLM_MODEL_FALLBACK=anthropic/claude-3-haiku
LLM_MODEL_BUDGET=openai/gpt-4o-mini
LLM_MODEL_SAMPLE=moonshotai/kimi-k2

# Token Limits
LLM_TOKENS_DEFAULT=1500
LLM_TOKENS_HOTEL_ANALYSIS=2500
LLM_TOKENS_COMPONENT_SELECTION=3500
LLM_TOKENS_SITE_CONFIG=4000
LLM_TOKENS_QUALITY_VALIDATION=2000
LLM_TOKENS_HOTEL_CONTENT=1000
LLM_TOKENS_TEST=100

# Generation Parameters
LLM_TEMPERATURE=0.7
LLM_TOP_P=1.0
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1000

# Infrastructure
DIRECTUS_URL=http://mock-directus:3001
# DIRECTUS_URL=http://directus:8055 # For production/real Directus

# Database
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=directus
MARIADB_USER=directus
MARIADB_PASSWORD=directus
