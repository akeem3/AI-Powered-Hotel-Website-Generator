{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env ENABLE_STATIC_EXPORT=true next build",
    "start": "next start",
    "mock:directus": "node ../mock-directus/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:simple": "jest --config jest.config.simple.js",
    "test:workflow": "jest --config jest.config.workflow.js",
    "test:e2e": "cross-env RUN_E2E_TESTS=true jest --config jest.config.workflow.js tests/e2e",
    "test:coverage": "jest --coverage --watchAll=false",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:contracts": "jest tests/contracts",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --stats-json",
    "chromatic": "chromatic --exit-zero-on-changes",
    "chromatic:strict": "chromatic",
    "validate:cva-tokens": "bash ../scripts/validate-cva-tokens.sh",
    "validate:contract-sync": "npx tsx scripts/validate-contract-cva-sync.ts",
    "validate:all": "npm run validate:cva-tokens && npm run validate:contract-sync",
    "validate:colors": "tsx scripts/validate-colors.ts",
    "prevalidate:contract-sync": "echo 'Running Contract-CVA sync validation...'"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@langchain/core": "^1.1.5",
    "@langchain/langgraph": "0.2.31",
    "@langfuse/client": "^4.5.1",
    "@langfuse/core": "^4.5.1",
    "@langfuse/otel": "^4.5.1",
    "@langfuse/tracing": "^4.5.1",
    "@openrouter/sdk": "^0.3.11",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@testing-library/dom": "^10.4.1",
    "ajv": "8.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "langfuse": "^3.38.6",
    "lucide-react": "^0.546.0",
    "next": "15.5.6",
    "react": "19.1.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.66.0",
    "sonner": "^2.0.7",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@storybook/addon-docs": "9.1.17",
    "@storybook/addon-links": "9.1.17",
    "@storybook/addon-themes": "9.1.17",
    "@storybook/react-vite": "9.1.17",
    "@tailwindcss/postcss": "^4.1.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dotenv": "^8.2.3",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.21",
    "chromatic": "^13.3.5",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.9",
    "eslint-plugin-storybook": "9.1.17",
    "express": "^4.18.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.4",
    "node-fetch": "^2.7.0",
    "postcss": "^8.5.6",
    "storybook": "9.1.17",
    "tailwindcss": "^4.1.15",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite": "^5.4.21"
  }
}
